node_modules/
.design/
.DS_Store
# Reference captures are reproducible with inspect.mjs; keep only the reports and the first screens.
data/references/captures/**/*.png
!data/references/captures/**/desktop-fold.png
!data/references/captures/**/mobile-fold.png
# Test-run measurements are reproducible; keep the reports, first screens and contact sheets.
examples/**/measure-*/**/*.png
!examples/**/measure-*/desktop-fold.png
!examples/**/measure-*/mobile-fold.png
!examples/**/measure-*/sheet-desktop.png
!examples/**/measure-*/sheet-mobile.png
# A run's design trail: page-by-page screenshots and motion frames are reproducible.
examples/**/design/**/*-page-[0-9]*.png
examples/**/design/**/motion-frames/
